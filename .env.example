APP_NAME="Bright Path Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your_email@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="your_email@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

SUPERVISOR_EMAIL=admin@yourdomain.com

# Security Settings
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
ADMIN_ALLOWED_IPS=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Automated tests ───────────────────────────────────────────────────────────
# Tests run ONLY against a separate local MySQL database named brightpath_testing.
# Create .env.testing (git-ignored) with the block below, uncommented.
# tests/TestCase.php aborts if the database is not brightpath_testing on a local host.
#
# Throwaway MySQL for tests (Docker):
#   docker run -d --name brightpath-testdb -p 127.0.0.1:33061:3306 --tmpfs /var/lib/mysql \
#     -e MYSQL_DATABASE=brightpath_testing -e MYSQL_USER=brightpath_test \
#     -e MYSQL_PASSWORD=<choose> -e MYSQL_ROOT_PASSWORD=<choose> mysql:8.0
#
# APP_ENV=testing
# APP_KEY=base64:<run: php artisan key:generate --show>
# APP_DEBUG=true
# APP_URL=http://localhost
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=33061
# DB_DATABASE=brightpath_testing
# DB_USERNAME=brightpath_test
# DB_PASSWORD=<choose>
