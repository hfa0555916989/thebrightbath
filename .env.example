APP_NAME="Bright Path Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Sessions, cache and queue live in the database (shared by all Laravel Cloud instances)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uploads use the "uploads" and "private" disks (config/filesystems.php). On Laravel Cloud,
# attach buckets with exactly those disk names; Cloud injects their credentials automatically.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Email is sent through Resend (https://resend.com), always via the queue.
# The sender domain (thebrightbath.com) must be verified in Resend (SPF/DKIM DNS records).
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="noreply@thebrightbath.com"
MAIL_FROM_NAME="${APP_NAME}"

# Video sessions (https://daily.co): Developers -> API key. Rooms are created automatically per booking.
DAILY_API_KEY=

SUPERVISOR_EMAIL=admin@yourdomain.com

# Security Settings
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# lax (not strict): the customer must stay signed in when coming back from the bank's payment page
SESSION_SAME_SITE=lax
# Admin control panel URL prefix (default: control-panel). A less guessable path hides it from bots.
ADMIN_PATH=control-panel
# reCAPTCHA v2 (checkbox) on the registration form: https://www.google.com/recaptcha/admin
# Leave both empty to disable it.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Automated tests ───────────────────────────────────────────────────────────
# Tests run ONLY against a separate local MySQL database named brightpath_testing.
# Create .env.testing (git-ignored) with the block below, uncommented.
# tests/TestCase.php aborts if the database is not brightpath_testing on a local host.
#
# Throwaway MySQL for tests (Docker):
#   docker run -d --name brightpath-testdb -p 127.0.0.1:33061:3306 --tmpfs /var/lib/mysql \
#     -e MYSQL_DATABASE=brightpath_testing -e MYSQL_USER=brightpath_test \
#     -e MYSQL_PASSWORD=<choose> -e MYSQL_ROOT_PASSWORD=<choose> mysql:8.0
#
# APP_ENV=testing
# APP_KEY=base64:<run: php artisan key:generate --show>
# APP_DEBUG=true
# APP_URL=http://localhost
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=33061
# DB_DATABASE=brightpath_testing
# DB_USERNAME=brightpath_test
# DB_PASSWORD=<choose>
